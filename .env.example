# Kalshi API (demo by default)
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/run/secrets/kalshi_private_key.pem
KALSHI_REST_BASE=https://demo-api.kalshi.co/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2

# Production (uncomment when ready)
# KALSHI_REST_BASE=https://api.elections.kalshi.com/trade-api/v2
# KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2

# Storage
REDIS_URL=redis://redis:6379/0
TIMESCALE_DSN=postgresql://kalshi:kalshi@timescaledb:5432/kalshi

# Logging — DEBUG=false: warnings/errors only; DEBUG=true: verbose terminal output
DEBUG=false
LOG_LEVEL=INFO
METRICS_PORT=8080
DISCOVERY_INTERVAL_SEC=30
REST_RPS=10
WS_SHARDS=4
